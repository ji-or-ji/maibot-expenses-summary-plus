{
  "manifest_version": 2,
  "id": "fulawa.maibot-expenses-summary-plus",
  "name": "麦麦财务总结优化",
  "version": "2.0.5",
  "description": "统计当天模型调用次数和花费，支持按量/订阅/混合三种计费口径（续费日周期、自动汇率），以默认或麦晨风模式生成转发消息财报。v2.0 起改为定时抓取官方价格页、按缓存命中/未命中/输出三分与峰谷时段计价，支持超阈值挂起与管理员确认，并可用真实牌价重建账本。v2.0.2 起比价前先按币种归一化，避免 USD/CNY 混比造成误报。v2.0.5 修复 /价格刷新 回报文字的占位符混用。",
  "author": {
    "name": "fulawa",
    "url": "https://github.com/ji-or-ji"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/ji-or-ji/maibot-expenses-summary-plus",
    "homepage": "https://github.com/ji-or-ji/maibot-expenses-summary-plus",
    "documentation": "https://github.com/ji-or-ji/maibot-expenses-summary-plus/blob/main/README.md",
    "issues": "https://github.com/ji-or-ji/maibot-expenses-summary-plus/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.6.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.forward",
    "send.text",
    "send.image",
    "chat",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "chat.open_session",
    "render.html2png",
    "llm.generate",
    "statistics.local.model_trend",
    "statistics.local.message_trend"
  ],
  "display": {
    "icon": {
      "type": "emoji",
      "value": "💸"
    }
  },
  "i18n": {
    "default_locale": "zh-CN"
  }
}