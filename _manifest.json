{
  "manifest_version": 2,
  "id": "fulawa.maibot-expenses-summary-plus",
  "name": "麦麦财务总结优化",
  "version": "1.0.4",
  "description": "统计当天模型调用次数和花费，支持按量/订阅/混合三种计费口径（续费日周期、自动汇率），以默认或麦晨风模式生成转发消息财报。",
  "author": {
    "name": "fulawa",
    "url": "https://github.com/jiruiyu330784"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/jiruiyu330784/maibot-expenses-summary-plus",
    "homepage": "https://github.com/jiruiyu330784/maibot-expenses-summary-plus",
    "documentation": "https://github.com/jiruiyu330784/maibot-expenses-summary-plus/blob/main/README.md",
    "issues": "https://github.com/jiruiyu330784/maibot-expenses-summary-plus/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.6.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.forward",
    "send.text",
    "send.image",
    "chat",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "chat.open_session",
    "render.html2png",
    "llm.generate",
    "statistics.local.model_trend",
    "statistics.local.message_trend"
  ],
  "display": {
    "icon": {
      "type": "emoji",
      "value": "💸"
    }
  },
  "i18n": {
    "default_locale": "zh-CN"
  }
}